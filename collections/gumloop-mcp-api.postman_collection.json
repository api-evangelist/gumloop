            "description": {
              "content": "Return the catalog of MCP servers visible to the caller — Gumloop-hosted (`gumcp_server`), user-deployed Gumstack (`gumstack_server`), and custom (`mcp_server`) — along with each server's connection state.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mcp",
                "servers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "team_id",
                  "value": "<string>",
                  "description": "Scope the catalog to a single team. When omitted, returns servers visible to the authenticated user."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
