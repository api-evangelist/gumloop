        {
          "id": "b4074683-dfeb-4489-8232-6a54d6f65dd6",
          "name": "List artifacts",
          "request": {
            "name": "List artifacts",
            "description": {
              "content": "List artifacts (files) produced by an agent. Optionally scope to a specific session, search by filename, sort, and paginate.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "agents",
                ":agent_id",
                "artifacts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "session_id",
                  "value": "<string>",
                  "description": "Filter to artifacts produced within a specific session."
                },
                {
                  "disabled": false,
                  "key": "search_query",
                  "value": "<string>",
                  "description": "Case-insensitive substring match against the artifact filename."
                },
                {
                  "disabled": false,
                  "key": "sort_order",
                  "value": "newest",
                  "description": "Sort order for results. Defaults to `newest`."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "20",
                  "description": "Number of artifacts to return per page. Clamped to 1–100."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque pagination cursor returned by a prior call as `next_cursor`."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "agent_id",
                  "description": "(Required) ID of the agent whose artifacts to list."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
