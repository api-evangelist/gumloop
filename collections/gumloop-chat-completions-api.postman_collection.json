  "item": [
    {
      "name": "chat",
      "item": [
        {
          "name": "completions",
          "item": [
            {
              "name": "Create chat completion",
              "id": "da7bf40b-4b93-4cce-9ead-5bf36eebdb27",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{bearerToken}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"model\": \"<string>\",\n  \"messages\": [],\n  \"stream\": false,\n  \"temperature\": \"<number>\",\n  \"max_completion_tokens\": \"<integer>\",\n  \"modalities\": [\n    \"text\",\n    \"image\"\n  ],\n  \"image_config\": {},\n  \"response_format\": {},\n  \"tools\": \"<array>\",\n  \"tool_choice\": \"<string>\",\n  \"provider\": {}\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "https://ws.gumloop.com/api/v1/chat/completions",
                  "protocol": "https",
                  "host": [
                    "ws",
                    "gumloop",
                    "com"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "chat",
                    "completions"
                  ]
                },
                "description": "OpenAI-compatible chat completions endpoint, multiplexed across every model Gumloop supports\n(Anthropic, OpenAI, Google Gemini, OpenRouter routes). Set `stream: true` for Server-Sent Events,\nor omit it for a unary JSON response. Image-generation models (`gpt-image-*`, `gemini-*-image-preview`,\n`dall-e-*`) are dispatched automatically when `modalities` includes `\"image\"` and yield image\nattachments on `choices[0].message.images`.\n\n### Streaming host\n\nChat completions live on the streaming host. Send all requests \u2014 unary or streaming \u2014 to:\n\n```\nPOST https://ws.gumloop.com/api/v1/chat/completions\n```\n\n`api.gumloop.com` does not serve this endpoint; the Python SDK routes there automatically.\n\n### Billing\n\nEach completion charges the caller's credit balance based on token usage (with cache-token semantics per provider) plus a flat 30-credit fee for image-gen calls. Users who configure their own provider API key get a 50% discount."
              },
              "response": [
                {
                  "id": "f4840fe5-b520-4d04-9859-b071677cf803",
                  "name": "Chat completion. When `stream` is `false` (or omitted), the response is the `chat.completion` envelope below. When `stream: true`, the response is `text/event-stream`; each event carries one `chat.completion.chunk` and the terminator is `data: [DONE]`.\n",
                  "originalRequest": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      },
                      {
                        "description": "Added as a part of security scheme: bearer",
                        "key": "Authorization",
                        "value": "Bearer <token>"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"model\": \"<string>\",\n  \"messages\": [],\n  \"stream\": false,\n  \"temperature\": \"<number>\",\n  \"max_completion_tokens\": \"<integer>\",\n  \"modalities\": [\n    \"text\",\n    \"image\"\n  ],\n  \"image_config\": {},\n  \"response_format\": {},\n  \"tools\": \"<array>\",\n  \"tool_choice\": \"<string>\",\n  \"provider\": {}\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "https://ws.gumloop.com/api/v1/chat/completions",
                      "protocol": "https",
                      "host": [
                        "ws",
                        "gumloop",
                        "com"
                      ],
                      "path": [
                        "api",
                        "v1",
                        "chat",
                        "completions"
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "{\n  \"id\": \"<string>\",\n  \"object\": \"<string>\",\n  \"created\": \"<integer>\",\n  \"model\": \"<string>\",\n  \"choices\": [\n    {\n      \"index\": \"<integer>\",\n      \"finish_reason\": \"content_filter\",\n      \"message\": {\n        \"role\": \"<string>\",\n        \"content\": \"<string>\",\n        \"reasoning\": \"<string>\"\n      }\n    },\n    {\n      \"index\": \"<integer>\",\n      \"finish_reason\": \"length\",\n      \"message\": {\n        \"role\": \"<string>\",\n        \"content\": \"<string>\",\n        \"reasoning\": \"<string>\"\n      }\n    }\n  ],\n  \"usage\": {\n    \"prompt_tokens\": \"<integer>\",\n    \"completion_tokens\": \"<integer>\",\n    \"total_tokens\": \"<integer>\",\n    \"cost\": \"<number>\",\n    \"is_byok\": \"<boolean>\"\n  }\n}",
                  "createdAt": "2026-10-22T01:08:51.000Z",
                  "updatedAt": "2026-10-22T01:08:51.000Z",
