      "item": [
        {
          "id": "2fd1d9ad-bbec-4544-b0da-17f3e5f7aa22",
          "name": "Create chat completion",
          "request": {
            "name": "Create chat completion",
            "description": {
              "content": "OpenAI-compatible chat completions endpoint, multiplexed across every model Gumloop supports\n(Anthropic, OpenAI, Google Gemini, OpenRouter routes). Set `stream: true` for Server-Sent Events,\nor omit it for a unary JSON response. Image-generation models (`gpt-image-*`, `gemini-*-image-preview`,\n`dall-e-*`) are dispatched automatically when `modalities` includes `\"image\"` and yield image\nattachments on `choices[0].message.images`.\n\n### Streaming host\n\nChat completions live on the streaming host. Send all requests — unary or streaming — to:\n\n```\nPOST https://ws.gumloop.com/api/v1/chat/completions\n```\n\n`api.gumloop.com` does not serve this endpoint; the Python SDK routes there automatically.\n\n### Billing\n\nEach completion charges the caller's credit balance based on token usage (with cache-token semantics per provider) plus a flat 30-credit fee for image-gen calls. Users who configure their own provider API key get a 50% discount.\n",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "api",
                "v1",
                "chat",
                "completions"
              ],
              "host": [
                "ws",
                "gumloop",
                "com"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"<string>\",\n  \"messages\": [\n    \"<object>\",\n    \"<object>\"\n  ],\n  \"stream\": false,\n  \"temperature\": \"<number>\",\n  \"max_completion_tokens\": \"<integer>\",\n  \"modalities\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"image_config\": \"<object>\",\n  \"response_format\": \"<object>\",\n  \"tools\": \"<array>\",\n  \"tool_choice\": \"<string>\",\n  \"provider\": \"<object>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "ad104bb3-3f27-4b6a-aaae-f1df26c81143",
              "name": "Chat completion. When `stream` is `false` (or omitted), the response is the `chat.completion` envelope below. When `stream: true`, the response is `text/event-stream`; each event carries one `chat.completion.chunk` and the terminator is `data: [DONE]`.\n",
              "originalRequest": {
                "url": {
                  "protocol": "https",
                  "path": [
                    "api",
                    "v1",
                    "chat",
                    "completions"
                  ],
                  "host": [
                    "ws",
                    "gumloop",
                    "com"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"model\": \"claude-sonnet-4-5\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Capital of Canada?\"\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": \"chatcmpl-9a3f8c2b14d6e7\",\n  \"object\": \"chat.completion\",\n  \"created\": 1747315920,\n  \"model\": \"claude-sonnet-4-5\",\n  \"choices\": [\n    {\n      \"index\": 0,\n      \"finish_reason\": \"stop\",\n      \"message\": {\n        \"role\": \"assistant\",\n        \"content\": \"Ottawa.\"\n      }\n    }\n  ],\n  \"usage\": {\n    \"prompt_tokens\": 12,\n    \"completion_tokens\": 1,\n    \"total_tokens\": 13\n  }\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
